{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"paths": { "#lib": ["./src/lib"], "#lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "test", "scripts", "e2e", "*.ts"],
	// RB-20: the service worker has its own WebWorker typings (src/service-worker/tsconfig.json, checked by `npm run check`).
	"exclude": ["src/service-worker"]
}
