{
	"name": "ruby",
	"private": true,
	"version": "0.5.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/studiomicro/ruby.git"
	},
	"homepage": "https://github.com/studiomicro/ruby",
	"bugs": {
		"url": "https://github.com/studiomicro/ruby/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p workers/jobs/tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "node scripts/machine-limits.ts && vitest run",
		"test:e2e": "node scripts/machine-limits.ts && playwright test",
		"build": "vite build",
		"gates": "npm run check && npm run lint && npm run test && npm run build",
		"types:cf": "rm -rf .svelte-kit/cloudflare && wrangler types --strict-vars=false src/worker-configuration.d.ts && wrangler types --strict-vars=false -c workers/jobs/wrangler.jsonc workers/jobs/worker-configuration.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "node scripts/migrate-local.ts",
		"db:seed:local": "node scripts/seed-local.ts",
		"db:reset:local": "node scripts/reset-local.ts",
		"deploy": "node scripts/deploy.ts",
		"readme:images": "node scripts/readme-images.ts",
		"jobs:dev": "wrangler dev -c workers/jobs/wrangler.jsonc --test-scheduled --persist-to .wrangler/state --port 8787",
		"prepare": "svelte-kit sync || echo ''"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"markdown-it": "^15.0.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261026.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	}
}
