# Copy to .deploy.env (gitignored, chmod 600) and fill in. `npm run deploy` reads it, or the same names from the
# environment (the environment wins). See docs/SELF_HOSTING.md. Never commit real values.

# Cloudflare account id (32 hex characters).
CLOUDFLARE_ACCOUNT_ID=
# D1 database id printed by `npx wrangler d1 create ruby` (a UUID).
RUBY_D1_DATABASE_ID=
# Host the Worker is served on, for example ruby.your-domain.example (a Cloudflare custom domain on your zone).
RUBY_APP_HOST=

# Cloudflare Access. Leave RUBY_ACCESS_DISABLED empty to require Access (then the next two are required).
RUBY_ACCESS_TEAM_DOMAIN=
RUBY_ACCESS_AUD=
# Set to 1 only if the deployment has no Access application in front (invite-only accounts still apply).
RUBY_ACCESS_DISABLED=

# Optional (RB-09): the verified Cloudflare Email Sending sender for reminder e-mail, for example
# ruby@your-domain.example. Leave empty to keep e-mail reminders off (reminders still arrive in-app).
RUBY_REMINDER_EMAIL_FROM=
